# Spotify Web API — keep real values private in Vercel Environment Variables
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=https://dcaribx.vercel.app/api/spotify/callback
# Keep false/undefined in normal operation. Temporarily set true only when reconnecting Spotify.
SPOTIFY_SETUP_ENABLED=false
